<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme with Material 3 DayNight NoActionBar -->
    <style name="Base.Theme.DoanAndroi" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/midnight_900</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/midnight_800</item>
        <item name="colorOnPrimaryContainer">@color/lime_accent</item>

        <item name="colorSecondary">@color/mint_600</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/mint_50</item>
        <item name="colorOnSecondaryContainer">@color/mint_600</item>

        <item name="colorTertiary">@color/academic_math</item>
        <item name="colorOnTertiary">@color/white</item>

        <!-- Background & Surface with High Contrast -->
        <item name="android:colorBackground">@color/ivory_50</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/ink_950</item>
        <item name="colorSurfaceVariant">@color/ivory_100</item>
        <item name="colorOnSurfaceVariant">@color/ink_700</item>

        <!-- Status bar: Light status bar with dark icons for clear visibility -->
        <item name="android:statusBarColor">@color/ivory_50</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.DoanAndroi" parent="Base.Theme.DoanAndroi" />

    <!-- Custom Card Style -->
    <style name="Widget.EduConnect.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">3dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/ivory_200</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>

    <!-- Custom Button Styles -->
    <style name="Widget.EduConnect.Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@color/midnight_900</item>
        <item name="android:textColor">@color/lime_accent</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.EduConnect.Button.Mint" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@color/mint_600</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
