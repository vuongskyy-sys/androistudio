<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/ivory_200"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Tutor Avatar -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgTutorAvatar"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_avatar_placeholder"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:srcCompat="@tools:sample/avatars" />

        <!-- Verified Badge Icon -->
        <ImageView
            android:id="@+id/imgVerifiedBadge"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_verified"
            app:tint="@color/mint_600"
            app:layout_constraintEnd_toEndOf="@id/imgTutorAvatar"
            app:layout_constraintBottom_toBottomOf="@id/imgTutorAvatar" />

        <!-- Tutor Name -->
        <TextView
            android:id="@+id/tvTutorName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:textColor="@color/ink_950"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/imgTutorAvatar"
            app:layout_constraintEnd_toStartOf="@id/btnFavorite"
            app:layout_constraintTop_toTopOf="@id/imgTutorAvatar"
            tools:text="Nguyễn Minh Trang" />

        <!-- Favorite Heart Button -->
        <ImageButton
            android:id="@+id/btnFavorite"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_heart"
            android:contentDescription="Lưu yêu thích"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/imgTutorAvatar" />

        <!-- Tutor Title / Degree -->
        <TextView
            android:id="@+id/tvTutorTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:textColor="@color/ink_600"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/imgTutorAvatar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTutorName"
            tools:text="Thạc sĩ Sư Phạm Toán — ĐH Sư Phạm TP.HCM" />

        <!-- Rating & Location Row -->
        <LinearLayout
            android:id="@+id/layoutRatingLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toEndOf="@id/imgTutorAvatar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTutorTitle">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_star"
                app:tint="@color/star_gold" />

            <TextView
                android:id="@+id/tvRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:textColor="@color/ink_900"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="4.9" />

            <TextView
                android:id="@+id/tvReviewsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:textColor="@color/ink_500"
                android:textSize="11sp"
                tools:text="(38)" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:textColor="@color/ink_300"
                android:text="•" />

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_location"
                app:tint="@color/ink_500" />

            <TextView
                android:id="@+id/tvDistrict"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:textColor="@color/ink_600"
                android:textSize="11sp"
                tools:text="Quận 1" />
        </LinearLayout>

        <!-- Subjects Chips / Tags -->
        <TextView
            android:id="@+id/tvSubjects"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_badge_academic"
            android:textColor="@color/academic_math"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutRatingLocation"
            tools:text="Toán 12 • Luyện thi ĐH • Toán Olympic" />

        <!-- Divider -->
        <View
            android:id="@+id/dividerCard"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@color/ivory_100"
            app:layout_constraintTop_toBottomOf="@id/tvSubjects" />

        <!-- Hourly Rate Label and Value -->
        <LinearLayout
            android:id="@+id/layoutPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dividerCard">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HỌC PHÍ"
                android:textColor="@color/ink_400"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHourlyRate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/midnight_900"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="250.000₫/h" />
        </LinearLayout>

        <!-- Actions: View Detail & Book -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewProfile"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Chi tiết"
            android:textColor="@color/ink_800"
            android:textSize="11sp"
            android:layout_marginEnd="6dp"
            app:strokeColor="@color/ivory_200"
            app:cornerRadius="10dp"
            app:layout_constraintEnd_toStartOf="@id/btnBookTrial"
            app:layout_constraintBottom_toBottomOf="@id/layoutPrice"
            app:layout_constraintTop_toTopOf="@id/layoutPrice" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBookTrial"
            style="@style/Widget.EduConnect.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Đặt lịch"
            android:textSize="11sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/layoutPrice"
            app:layout_constraintTop_toTopOf="@id/layoutPrice" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
